---
import dayjs from "dayjs";
import "dayjs/locale/es";
dayjs.locale("es");
import { members_api_url } from "../data/conf.json";
import { Image, type ImgAttributes } from 'astro:assets';
import { convertASCIICharsToText, convertMarkdownToPlainText } from "markdown-to-text-renderer";

interface Props {
  post: any;
  imgLoading: ImgAttributes['loading'];
}

const { post, imgLoading } = Astro.props;
const response = await fetch(members_api_url + "/members/" + post.data.username);
const user_data = await response.json();
const description = post.data.description
  ? post.data.description
  : convertASCIICharsToText(convertMarkdownToPlainText(post.body.slice(0, 160))) + "...";

const display_date = dayjs(post.data.pubDate).format("D MMM. YYYY");
---

 <a 
  href={"/publicaciones/" + post.slug} 
  class="w-full h-full flex flex-col space-y-6 md:px-8 first:pl-0 last:pr-0"
>
  {
    post.data.image && (
      <Image
        src={post.data.image}
        alt={post.data.title + " logo"}
        class='aspect-[400/225] object-cover rounded border border-[#1b1c1e]'
        format="webp"
        quality={85}
        width={800}
        height={450}
        loading={imgLoading}
      />
    )
  }

  <div class="space-y-2">
    <h3 class="mb-2 text-lg md:text-2xl line-clamp-2 font-semibold tracking-tight text-gray-900 dark:text-white">
      {post.data.title}
    </h3>
    <p class="mb-5 font-normal text-[#8a8f98] line-clamp-3">
      {description}
    </p>
  </div>

  <span class="mt-auto text-sm text-[#62666d]">
    {user_data.name}
    <span class="inline-block [margin-inline:4px]">·</span>
    {display_date}
  </span>
</a>

